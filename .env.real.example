# API + auth
JWT_SECRET=change-this-to-a-long-random-secret
JWT_ISSUER=mira-vpn-api
JWT_TTL_MINUTES=15

# Postgres exposed by docker-compose.real.yml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mira_vpn
POSTGRES_HOST_PORT=15432

# API published host port
API_HOST_PORT=18080

# WireGuard manager API client settings
WGMGR_TIMEOUT_SECONDS=8

# Client tunnel MTU in generated .conf (1280 reduces PMTU black holes; 0 omits the line)
WGMGR_CLIENT_MTU=1280

# Multi-location registry loaded by API.
# Copy config/location-profiles.example.json to config/location-profiles.json and edit (see config/README.md).
# In docker-compose, ./config is mounted to /etc/mira-config read-only.
WGMGR_LOCATION_PROFILES_FILE=/etc/mira-config/location-profiles.json
# Or use inline JSON (avoid if values contain characters that confuse your shell; prefer the file):
# WGMGR_LOCATION_PROFILES_JSON=[{"name":"Finland","endpoint":"fi.example:443","serverPublicKey":"..."}]

# wgmgr admin tokens (per-POP token overrides default).
WGMGR_ADMIN_TOKEN_DEFAULT=replace-with-long-random-token
# WGMGR_ADMIN_TOKEN_USA_COLORADO=replace-with-pop-specific-token
# WGMGR_ADMIN_TOKEN_FRANCE_PARIS=replace-with-pop-specific-token
