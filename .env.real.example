# API + auth
JWT_SECRET=change-this-to-a-long-random-secret
JWT_ISSUER=mira-vpn-api
JWT_TTL_MINUTES=15

# Postgres exposed by docker-compose.real.yml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mira_vpn
POSTGRES_HOST_PORT=15432

# API host port (host networking mode)
PORT=18080

# Real WireGuard manager mode
WGMGR_MODE=real
WGMGR_REAL_INTERFACE=wg0
WGMGR_REAL_ENDPOINT=95.217.206.233:51820
WGMGR_REAL_SERVER_PUBLIC_KEY=replace-with-server-public-key
WGMGR_REAL_DNS=1.1.1.1
WGMGR_REAL_ALLOWED_IPS=0.0.0.0/0
WGMGR_REAL_DRY_RUN=false
WGMGR_REAL_COMMAND_TIMEOUT_SECONDS=8

# Persist peer artifacts
WGMGR_HOST_OUTPUT_DIR=./var/wgmgr-real
WGMGR_REAL_OUTPUT_DIR=/var/lib/wgmgr-real
